{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "purpose": [
                "debug-test"
            ],
            "justMyCode": false,
            "stopOnEntry": false,
            "env": {
                // Necessary for debugging tests
                "PYTEST_ADDOPTS": "--no-cov"
            }
        },
        {
            "name": "Python Debugger: napari",
            "type": "debugpy",
            "request": "launch",
            "module": "napari",
            "justMyCode": false
        }
    ]
}
